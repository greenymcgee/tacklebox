{
  "name": "@greenymcgee/typescript-utils",
  "version": "0.1.7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenymcgee/tacklebox.git",
    "directory": "packages/typescript-utils"
  },
  "homepage": "https://github.com/greenymcgee/tacklebox/tree/main/packages/typescript-utils",
  "bugs": {
    "url": "https://github.com/greenymcgee/tacklebox/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "lint": "eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@greenymcgee/utility-types": "^0.1.0",
    "tsup": "^8.5.1"
  }
}
